# Noema local configuration — copy to `.env` and fill in your own values.
# Never commit `.env` or real API keys. See README §25 (Configuration).
#
# Provider API keys (example placeholders only):
GEMINI_API_KEY=your_api_key_here
OPENROUTER_API_KEY=your_api_key_here

# Local daemon bindings:
NOEMA_HOST=127.0.0.1
NOEMA_PORT=8765
NOEMA_WS_PORT=8766

# Telemetry source (ActivityWatch by default):
NOEMA_TELEMETRY_URL=http://127.0.0.1:5600

# Provider selection (`hosted`, `ollama`, or `gemini`):
NOEMA_PROVIDER=hosted
NOEMA_OLLAMA_ENABLED=true
NOEMA_OLLAMA_MODEL=
NOEMA_GEMINI_MODEL=
NOEMA_GEMINI_API_KEY_ENV=GEMINI_API_KEY

# Classification scheduling:
NOEMA_BACKGROUND_AI=true
NOEMA_CLASSIFICATION_INTERVAL_MINUTES=20
NOEMA_CLASSIFICATION_MAX_RETRIES=5
NOEMA_CLASSIFICATION_VERSION=v1
NOEMA_MAX_PER_RUN=60

# Model tiers (comma-separated; must stay within their tier):
NOEMA_CLASSIFICATION_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
NOEMA_REASONING_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
NOEMA_MEME_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
NOEMA_AUXILIARY_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# Realtime drift detection:
NOEMA_REALTIME_ENABLED=true
NOEMA_REALTIME_EVAL_SECONDS=60

# Intervention policy:
NOEMA_INTERVENTION_MODE=meme
NOEMA_INTERVENTION_COOLDOWN=900

# Presence / sessions:
AFK_TIMEOUT_SECONDS=180
SESSION_MERGE_GAP_SECONDS=15

# Retention / logging:
NOEMA_METRICS_RETENTION_DAYS=30
NOEMA_LOG_LEVEL=INFO
