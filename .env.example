# Copy to `.env` and adjust. `.env` is gitignored and is the single
# file-based source of daemon settings (loaded at startup from the
# working directory). Explicitly exported variables take precedence.
# Empty values fall back to built-in defaults.
#
# Canonical prefix is NOEMA_*. Historical AI_ACTIVITY_OS_* names remain
# accepted by the config loader (canonical wins on conflict).

# Optional hosted classification access
GEMINI_API_KEY=

# Telemetry source instance to ingest from (ActivityWatch-compatible;
# optional legacy source — native collectors are the primary path)
NOEMA_TELEMETRY_URL=http://127.0.0.1:5600

# Noema-native telemetry collectors (preferred production path).
# When true, Noema observes the foreground window and input presence
# itself and keeps working with ActivityWatch stopped.
NOEMA_NATIVE_ENABLED=true
NOEMA_NATIVE_POLL_SECONDS=1.0
NOEMA_NATIVE_HEARTBEAT_SECONDS=5.0
NOEMA_NATIVE_PRESENCE_HEARTBEAT_SECONDS=5.0

# SQLite database path (empty = default under %LOCALAPPDATA%\Noema)
NOEMA_DB=

# Daemon JSON config file (empty = none)
NOEMA_CONFIG=

# Local API bind address and ports
NOEMA_HOST=127.0.0.1
NOEMA_PORT=8765
NOEMA_WS_PORT=8766

# Classification provider and models
NOEMA_PROVIDER=ollama
NOEMA_OLLAMA_MODEL=llama3.2:3b
NOEMA_BACKGROUND_AI=true
NOEMA_GEMINI_MODEL=gemini-3.5-flash
NOEMA_GEMINI_API_KEY_ENV=GEMINI_API_KEY

# Max sessions classified per semantic run (newest-first chunk; remainder continues next cadence)
NOEMA_MAX_PER_RUN=60

# Autonomous classification cadence in minutes (20-minute processing opportunity)
NOEMA_CLASSIFICATION_INTERVAL_MINUTES=20
NOEMA_CLASSIFICATION_MAX_RETRIES=5
NOEMA_CLASSIFICATION_VERSION=1

# OpenRouter tier (disabled by default: classification is Gemini-only.
# The key must stay in this file: it is never sent to the browser, logs, or database.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_TIMEOUT_SECONDS=60

# Ranked Gemini fallback models (comma-separated, highest priority first)
NOEMA_GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Local final fallback (false removes Ollama from the chain entirely)
NOEMA_OLLAMA_ENABLED=true

# Real-time behavioral detection (independent of the 10-minute scheduler)
NOEMA_REALTIME_ENABLED=true
NOEMA_REALTIME_EVAL_SECONDS=60
NOEMA_FAST_MODEL_TIMEOUT_SECONDS=20
NOEMA_DETECTOR_ENTER=0.70
NOEMA_DETECTOR_EXIT=0.50
NOEMA_INTERVENTION_MODE=NOTIFICATION
NOEMA_INTERVENTION_COOLDOWN=900

# User presence (input timing from the source AFK signal; window focus is not presence)
AFK_TIMEOUT_SECONDS=180
AFK_POLL_INTERVAL_SECONDS=5
AFK_MEDIA_EXCEPTION=false

# Sessionizer merge thresholds, measured against live telemetry
# (median event ~1s, ~70% under 5s, ~85% under 15s)
SESSION_SHORT_EVENT_SECONDS=5
SESSION_MERGE_GAP_SECONDS=15

# Ingestion lookback window in seconds
NOEMA_LOOKBACK_SECONDS=60

# Observability retention in days (telemetry tables only; product
# activity/session/classification data is never pruned by this setting)
NOEMA_METRICS_RETENTION_DAYS=30

# Daemon log level
NOEMA_LOG_LEVEL=INFO
