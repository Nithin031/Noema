# Noema local configuration — copy to `.env` and fill in your own values.
# Never commit `.env` or real API keys. See README §25 (Configuration).
#
# Provider API keys (example placeholders only):
GEMINI_API_KEY=your_api_key_here
OPENROUTER_API_KEY=your_api_key_here

# Local daemon bindings:
NOEMA_HOST=127.0.0.1
NOEMA_PORT=8765
NOEMA_WS_PORT=8766

# Telemetry source (ActivityWatch by default):
NOEMA_TELEMETRY_URL=http://127.0.0.1:5600

# Provider selection (`hosted`, `ollama`, or `gemini`):
NOEMA_PROVIDER=hosted
NOEMA_OLLAMA_ENABLED=true
NOEMA_OLLAMA_MODEL=
NOEMA_GEMINI_MODEL=
NOEMA_GEMINI_API_KEY_ENV=GEMINI_API_KEY

# Classification scheduling:
NOEMA_BACKGROUND_AI=true
NOEMA_CLASSIFICATION_INTERVAL_MINUTES=20
NOEMA_CLASSIFICATION_MAX_RETRIES=5
NOEMA_CLASSIFICATION_VERSION=v1
NOEMA_MAX_PER_RUN=60

# Model tiers (comma-separated; must stay within their tier):
NOEMA_CLASSIFICATION_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
NOEMA_REASONING_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
NOEMA_MEME_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
NOEMA_AUXILIARY_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# Realtime drift detection:
NOEMA_REALTIME_ENABLED=true
NOEMA_REALTIME_EVAL_SECONDS=60

# Intervention policy:
NOEMA_INTERVENTION_MODE=meme
NOEMA_INTERVENTION_COOLDOWN=900

# Presence / sessions:
AFK_TIMEOUT_SECONDS=180
SESSION_MERGE_GAP_SECONDS=15

# Retention / logging:
NOEMA_METRICS_RETENTION_DAYS=30
NOEMA_LOG_LEVEL=INFO

# --- External LLM lanes (opt-in). Order: web LLM -> Claude Code -> OpenRouter -> Gemini (last) ---
# Web LLM = DeepSeek through a hub API of Noema's own (port 8767) that ATTACHES to the browser you
# already have signed in (the one Quaero uses). No new browser or login. Start it with:
#   .\scripts\noema_webllm_hub.ps1
NOEMA_WEBLLM_ENABLED=0
NOEMA_WEBLLM_URL=http://127.0.0.1:8767
# DeepSeek: the one hub provider no other app of yours uses, so Noema never competes for it.
NOEMA_WEBLLM_PROVIDER=deepseek
# Claude Code: its own `claude -p` process per call, tools off, no history.
NOEMA_CLAUDE_CODE_ENABLED=0
NOEMA_CLAUDE_CODE_MODEL=claude-sonnet-5-5
NOEMA_CLAUDE_CODE_EFFORT=low
# Apps that always go first. While <name>.busy in the lane dir is fresh, Noema skips the web LLM.
NOEMA_LLM_LANE_RIVALS=quaero
# Strict alignment ("exam mode"): any confident work unrelated to your intent counts as drift.
NOEMA_STRICT_ALIGNMENT=0
# Side-project mode: words that make any app/title/domain count as on-task whatever the intent says
# (comma separated, case-insensitive). E.g. the tools you build with while studying for an exam.
NOEMA_ALLOW_RULES=
# ...but only while your intent is a build goal (contains one of these words). Studying is isolated time.
NOEMA_ALLOW_RULES_FOR=build,develop,coding,implement,noema,app,fix
# ActivityWatch is optional; Noema has its own native watcher. false = never polled (no warnings).
NOEMA_ACTIVITYWATCH_ENABLED=true
# Background watcher: apps open behind your work + apps playing audio (app names and minutes only).
# Audio detection needs: pip install pycaw
NOEMA_BACKGROUND_WATCH=true
# NOEMA_LLM_LANE_DIR=%LOCALAPPDATA%LLM-LANE
