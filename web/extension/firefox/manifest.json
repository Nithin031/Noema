{
  "manifest_version": 2,
  "name": "Noema",
  "version": "0.1.0",
  "description": "Receives exact-tab, local Noema interventions.",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "notifications",
    "<all_urls>",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "ws://127.0.0.1:8766/*",
    "ws://localhost:8766/*"
  ],
  "background": {
    "scripts": ["api/client.js", "background.js"]
  },
  "browser_action": {
    "default_title": "Noema",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/meme-renderer.js", "content/intervention-overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "noema@example.local",
      "strict_min_version": "109.0"
    }
  }
}
